<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- 08 Mes partages (§8.3) -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.ihmshare.ManageVideosController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" style="-fx-background-color: white;">
    <VBox spacing="20" style="-fx-background-color: white;">
        <padding>
            <Insets top="28" right="40" bottom="28" left="40"/>
        </padding>
        <HBox alignment="CENTER_LEFT">
            <Label text="Mes partages" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Ajouter un partage" styleClass="primary" onAction="#addVideo"/>
        </HBox>
        <VBox fx:id="videos_box" spacing="20"/>
        <Label fx:id="empty_label" text="Vous ne partagez aucune vidéo pour le moment." styleClass="text-secondary"/>
    </VBox>
</ScrollPane>
