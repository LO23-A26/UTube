<?xml version="1.0" encoding="UTF-8"?>

<!-- 06 Visionneuse : lecture d'une vidéo locale (partagée ou téléchargée) avec MediaPlayer -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="16.0" styleClass="content-area" stylesheets="@../../ihmmain/css/utube.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="28.0" left="40.0" right="40.0" top="28.0"/>
    </padding>

    <!-- Ramène au détail de la vidéo (05b ou 05c) -->
    <Button fx:id="back_button" styleClass="back-button" text="‹  Retour"/>

    <!-- Le contrôleur lie fitWidth/fitHeight de media_view à la taille de player_container -->
    <StackPane fx:id="player_container" minHeight="300.0" styleClass="player-area" VBox.vgrow="ALWAYS">
        <MediaView fx:id="media_view" preserveRatio="true"/>
        <Button fx:id="overlay_play_button" styleClass="player-overlay-button">
            <graphic>
                <SVGPath content="M0 0 L30 20 L0 40 Z" styleClass="player-overlay-icon"/>
            </graphic>
        </Button>
    </StackPane>

    <HBox alignment="CENTER_LEFT" spacing="14.0">
        <!-- « Lecture » / « Pause » -->
        <Button fx:id="play_pause_button" prefWidth="76.0" text="Lecture"/>
        <ProgressBar fx:id="progress_bar" maxWidth="Infinity" prefHeight="6.0" progress="0.0" HBox.hgrow="ALWAYS"/>
        <Label fx:id="time_label" styleClass="secondary-text" text="00:00 / 00:00"/>
    </HBox>

    <Label fx:id="video_title_label" styleClass="card-title" text="Titre de la vidéo"/>

    <!-- Format non supporté par MediaPlayer, fichier introuvable... -->
    <Label fx:id="error_label" managed="false" styleClass="error-label" visible="false" wrapText="true"/>
</VBox>
