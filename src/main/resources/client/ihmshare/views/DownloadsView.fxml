<?xml version="1.0" encoding="UTF-8"?>

<!-- 07 Mes téléchargements : une ligne cliquable par vidéo téléchargée (ouvre 05b) -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="content-area" stylesheets="@../../ihmmain/css/utube.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="28.0" left="40.0" right="40.0" top="28.0"/>
    </padding>

    <Label styleClass="page-title" text="Mes téléchargements"/>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <!-- Rempli par le contrôleur avec des DownloadedVideoRow -->
        <VBox fx:id="downloads_container" spacing="20.0"/>
    </ScrollPane>

    <Label fx:id="empty_label" managed="false" styleClass="hint-text"
           text="Aucune vidéo téléchargée pour le moment." visible="false"/>
</VBox>
