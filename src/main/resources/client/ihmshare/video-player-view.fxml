<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- 06 Video player (§8.3) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.ihmshare.VideoPlayerController"
      spacing="20" style="-fx-background-color: white;">
    <padding>
        <Insets top="28" right="40" bottom="28" left="40"/>
    </padding>

    <Hyperlink text="Retour" styleClass="back" onAction="#goBack">
        <graphic>
            <ImageView><Image url="@../../assets/icons/retour.png"/></ImageView>
        </graphic>
    </Hyperlink>

    <!-- Playing area on a black background -->
    <StackPane fx:id="screen_pane" VBox.vgrow="ALWAYS" minHeight="300"
               style="-fx-background-color: #141414; -fx-background-radius: 10px;">
        <ImageView fx:id="play_icon" fitWidth="40" fitHeight="40" preserveRatio="true"
                   onMouseClicked="#togglePlay" style="-fx-cursor: hand;">
            <Image url="@../../assets/icons/lecture.png"/>
        </ImageView>
    </StackPane>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <Button fx:id="play_button" text="Lecture" styleClass="small" onAction="#togglePlay"/>
        <ProgressBar fx:id="progress_bar" progress="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                     styleClass="video-progress"/>
        <Label fx:id="time_label" text="00:00 / 00:00" styleClass="text-secondary"/>
    </HBox>

    <Label fx:id="title_label" styleClass="section-title"/>
</VBox>
