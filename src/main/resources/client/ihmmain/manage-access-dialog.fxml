<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Maquette v2 · 08a Gérer les accès d'une vidéo (fenêtre) -->
<VBox styleClass="modal" prefWidth="560" maxHeight="-Infinity" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.ihmmain.ManageAccessDialogController"
      style="-fx-spacing: 8px;">
    <Label text="Gérer les accès" styleClass="modal-title"/>
    <Label fx:id="video_title_label" styleClass="field-label"/>
    <Label text="Droits d'accès par liste" styleClass="section-title"/>
    <Label text="Cochez ce que chaque liste peut faire sur cette vidéo. Les changements s'appliquent dès l'enregistrement."
           styleClass="text-small" wrapText="true"/>

    <VBox fx:id="access_rows_container"/>

    <HBox styleClass="actions" style="-fx-padding: 8px 0 0 0;">
        <Button text="Annuler" cancelButton="true" onAction="#cancel"/>
        <Button text="Enregistrer" styleClass="primary" defaultButton="true" onAction="#save"/>
    </HBox>
</VBox>
