<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!-- Mockup v2 · 12 "Mon profil": displayed in the content area of the main view -->
<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.ihmmain.ProfileController"
            fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="20" style="-fx-padding: 28px 40px;">

        <!-- Title -->
        <Label text="Mon profil" styleClass="page-title"/>

        <HBox styleClass="card,large" spacing="28" style="-fx-padding: 36px;">

            <!-- Avatar -->
            <VBox spacing="12" alignment="TOP_CENTER" minWidth="130">
                <Circle fx:id="avatarPreview"
                        radius="56"
                        fill="#E6E7E3"
                        stroke="#D9DBE0"
                        strokeWidth="1"/>

                <Button text="Changer l'avatar"
                        styleClass="small"
                        onAction="#chooseAvatar"/>
            </VBox>

            <!-- Form in 2 columns -->
            <GridPane hgap="16" vgap="14" HBox.hgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Pseudo -->
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Pseudo"
                           styleClass="field-label"
                           labelFor="$pseudoField"/>
                    <TextField fx:id="pseudoField"/>
                </VBox>

                <!-- Password -->
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Mot de passe"
                           styleClass="field-label"
                           labelFor="$passwordField"/>
                    <Label text="(laisser vide pour ne pas le changer)" styleClass="text-secondary"/>
                    <PasswordField fx:id="passwordField"/>
                </VBox>

                <!-- Name -->
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Nom"
                           styleClass="field-label"
                           labelFor="$lastNameField"/>
                    <Label text="(optionnel)" styleClass="text-secondary"/>
                    <TextField fx:id="lastNameField"/>
                </VBox>

                <!-- First name -->
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Prénom"
                           styleClass="field-label"
                           labelFor="$firstNameField"/>
                    <Label text="(optionnel)" styleClass="text-secondary"/>
                    <TextField fx:id="firstNameField"/>
                </VBox>

                <!-- Date of birth -->
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Date de naissance"
                           styleClass="field-label"
                           labelFor="$birthDatePicker"/>
                    <Label text="(optionnel)" styleClass="text-secondary"/>
                    <DatePicker fx:id="birthDatePicker" promptText="jj/mm/aaaa" maxWidth="Infinity"/>
                </VBox>
            </GridPane>
        </HBox>

        <!-- Error message -->
        <Label fx:id="errorLabel"
               styleClass="text-secondary"
               wrapText="true"
               visible="false"
               managed="${errorLabel.visible}"/>

        <!-- Actions -->
        <HBox alignment="CENTER_RIGHT" spacing="12">
            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Annuler"
                    onAction="#cancel"/>

            <Button text="Enregistrer les modifications"
                    styleClass="primary"
                    defaultButton="true"
                    onAction="#saveProfile"/>
        </HBox>

    </VBox>
</ScrollPane>
