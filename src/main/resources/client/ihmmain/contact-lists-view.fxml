<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Maquette v2 · 10 Listes de contacts (affichée dans le layout de HomeController) -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.ihmmain.ContactListsController" fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent;">
    <VBox spacing="20" style="-fx-padding: 28px 40px;">
        <HBox alignment="CENTER_LEFT">
            <Label text="Listes de contacts" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Créer une liste" styleClass="primary" onAction="#openCreateList"/>
        </HBox>
        <FlowPane fx:id="contact_lists_container" hgap="16" vgap="16"/>
        <Label fx:id="empty_label" text="Aucune liste de contacts." styleClass="text-secondary"
               visible="false" managed="${empty_label.visible}"/>
    </VBox>
</ScrollPane>
