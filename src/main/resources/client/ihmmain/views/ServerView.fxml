<?xml version="1.0" encoding="UTF-8"?>

<!-- 03 Serveur : consulter le serveur courant et en changer (une seule connexion à la fois) -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="800.0" prefWidth="1280.0" styleClass="offline-background"
           stylesheets="@../css/utube.css"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <VBox maxHeight="-Infinity" maxWidth="720.0" spacing="18.0" styleClass="card">
        <padding>
            <Insets bottom="36.0" left="36.0" right="36.0" top="28.0"/>
        </padding>

        <!-- Ramène à l'écran précédent -->
        <Button fx:id="back_button" styleClass="back-button" text="‹  Retour"/>

        <fx:include source="components/Logo.fxml"/>
        <Label styleClass="page-title" text="Serveur"/>

        <!-- Serveur actuel -->
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="status-box">
            <padding>
                <Insets bottom="14.0" left="16.0" right="18.0" top="14.0"/>
            </padding>
            <Circle fx:id="server_status_dot" radius="5.0" styleClass="status-dot-online"/>
            <Label fx:id="current_server_label" text="[Adresse IP] : [Port]"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="server_status_label" styleClass="secondary-text" text="Connecté"/>
            <Region prefWidth="40.0"/>
            <Button fx:id="disconnect_server_button" text="Se déconnecter du serveur"/>
        </HBox>

        <Label styleClass="hint-text" wrapText="true"
               text="Une seule connexion serveur à la fois : se connecter à un autre serveur ferme la connexion actuelle."/>

        <!-- Changer de serveur -->
        <Label styleClass="field-label" text="Changer de serveur">
            <VBox.margin>
                <Insets top="6.0"/>
            </VBox.margin>
        </Label>
        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Adresse IP"/>
                <TextField fx:id="server_ip_field"/>
            </VBox>
            <VBox prefWidth="130.0" spacing="8.0">
                <Label styleClass="field-label" text="Port"/>
                <TextField fx:id="server_port_field"/>
            </VBox>
            <Button fx:id="connect_button" defaultButton="true" styleClass="primary-button" text="Se connecter"/>
        </HBox>

        <Label fx:id="error_label" managed="false" styleClass="error-label" visible="false" wrapText="true"/>
    </VBox>
</StackPane>
