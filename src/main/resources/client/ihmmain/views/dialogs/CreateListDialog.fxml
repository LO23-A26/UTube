<?xml version="1.0" encoding="UTF-8"?>

<!-- 10a Créer une liste (fenêtre) : nom de la liste et droits de ses membres (séquence 5.1.6.2) -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="440.0" spacing="16.0" styleClass="modal-card"
      stylesheets="@../../css/utube.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <Label styleClass="modal-title" text="Créer une liste"/>

    <VBox spacing="8.0">
        <Label styleClass="field-label" text="Nom de la liste"/>
        <TextField fx:id="list_name_field"/>
    </VBox>

    <VBox spacing="10.0">
        <Label styleClass="field-label" text="Droits des membres sur mes vidéos"/>
        <HBox spacing="20.0">
            <CheckBox fx:id="download_checkbox" selected="true" text="Télécharger"/>
            <CheckBox fx:id="rate_checkbox" selected="true" text="Noter"/>
            <CheckBox fx:id="comment_checkbox" selected="true" text="Commenter"/>
        </HBox>
    </VBox>

    <!-- ListAlreadyExistsException -->
    <Label fx:id="error_label" managed="false" styleClass="error-label" text="Une liste porte déjà ce nom."
           visible="false" wrapText="true"/>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button fx:id="cancel_button" cancelButton="true" styleClass="large-button" text="Annuler"/>
        <Button fx:id="create_button" defaultButton="true" styleClass="primary-button" text="Créer la liste"/>
    </HBox>
</VBox>
