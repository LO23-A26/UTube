<?xml version="1.0" encoding="UTF-8"?>

<!--
    Fenêtre de confirmation IHM-Main (séquences 5.1.6.3 et 5.1.6.5) :
    « Supprimer la liste ? » ou « Retirer ce contact ? ».
    Le contrôleur adapte le titre, le message et le libellé du bouton d'action (« Supprimer » ou « Retirer »).
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="420.0" spacing="12.0" styleClass="modal-card"
      stylesheets="@../../css/utube.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <Label fx:id="title_label" styleClass="modal-title" text="Supprimer la liste ?" wrapText="true"/>
    <Label fx:id="message_label" styleClass="secondary-text" wrapText="true"
           text="La liste et les droits d'accès associés seront supprimés. Les contacts ne sont pas prévenus."/>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <padding>
            <Insets top="8.0"/>
        </padding>
        <Button fx:id="cancel_button" cancelButton="true" styleClass="large-button" text="Annuler"/>
        <Button fx:id="confirm_button" defaultButton="true" styleClass="primary-button" text="Supprimer"/>
    </HBox>
</VBox>
