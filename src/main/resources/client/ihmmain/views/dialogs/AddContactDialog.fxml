<?xml version="1.0" encoding="UTF-8"?>

<!-- 10b Ajouter un contact (fenêtre) : utilisateur·rice·s connu·e·s absent·e·s de la liste (séquence 5.1.6.4) -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="460.0" spacing="16.0" styleClass="modal-card"
      stylesheets="@../../css/utube.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <Label fx:id="dialog_title_label" styleClass="modal-title" text="Ajouter un contact à « [Nom de la liste] »"
           wrapText="true"/>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="300.0">
        <!-- Rempli par le contrôleur avec des AddContactRow -->
        <VBox fx:id="available_users_container"/>
    </ScrollPane>

    <Label fx:id="empty_label" managed="false" styleClass="hint-text"
           text="Tous les utilisateurs connus sont déjà dans cette liste." visible="false" wrapText="true"/>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button fx:id="close_button" cancelButton="true" styleClass="large-button" text="Fermer"/>
        <Button fx:id="finish_button" defaultButton="true" styleClass="primary-button" text="Terminer"/>
    </HBox>
</VBox>
