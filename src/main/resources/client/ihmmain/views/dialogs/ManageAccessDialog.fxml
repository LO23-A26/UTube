<?xml version="1.0" encoding="UTF-8"?>

<!--
    08a Gérer les accès d'une vidéo (fenêtre, séquence 5.1.6.6).
    Gérée par IHM-Main, ouverte depuis l'écran 08 Mes partages ou 05c Détail vidéo (IHM-Share).
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="600.0" spacing="14.0" styleClass="modal-card"
      stylesheets="@../../css/utube.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <Label styleClass="modal-title" text="Gérer les accès"/>
    <Label fx:id="video_title_label" styleClass="video-title" text="Titre de la vidéo" wrapText="true"/>
    <Label styleClass="hint-text" wrapText="true"
           text="Choisissez ce que chaque liste de contacts peut faire avec cette vidéo."/>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="260.0">
        <!-- Rempli par le contrôleur avec un AccessRightsRow par liste de contacts -->
        <VBox fx:id="access_rows_container"/>
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button fx:id="cancel_button" cancelButton="true" styleClass="large-button" text="Annuler"/>
        <Button fx:id="save_button" defaultButton="true" styleClass="primary-button" text="Enregistrer"/>
    </HBox>
</VBox>
