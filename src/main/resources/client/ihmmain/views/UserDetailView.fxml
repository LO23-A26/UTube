<?xml version="1.0" encoding="UTF-8"?>

<!-- 11 Détail utilisateur·rice : profil d'un·e utilisateur·rice connecté·e et ses vidéos partagées -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="20.0" styleClass="content-area" stylesheets="@../css/utube.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="28.0" left="40.0" right="40.0" top="28.0"/>
    </padding>

    <Button fx:id="back_button" styleClass="back-button" text="‹  Retour"/>

    <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="card">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
        </padding>
        <Circle fx:id="avatar_circle" radius="49.0" styleClass="avatar"/>
        <VBox alignment="CENTER_LEFT" spacing="6.0">
            <Label fx:id="pseudo_label" styleClass="profile-name" text="Pseudo"/>
            <!-- Âge calculé à partir de la date de naissance du profil -->
            <Label fx:id="identity_label" styleClass="secondary-text" text="Nom Prénom · Âge"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Ouvre le menu 11a (AddToListMenu) sous le bouton -->
        <Button fx:id="add_to_list_button" contentDisplay="RIGHT" graphicTextGap="10.0" styleClass="primary-button"
                text="Ajouter à une liste">
            <graphic>
                <SVGPath content="M0 0 L4.5 4.5 L9 0" styleClass="icon"/>
            </graphic>
        </Button>
    </HBox>

    <Label styleClass="section-title" text="Vidéos partagées"/>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <!-- Rempli par le contrôleur avec des VideoCard (un clic ouvre 05 ou 05b) -->
        <FlowPane fx:id="shared_videos_container" hgap="16.0" vgap="16.0"/>
    </ScrollPane>

    <Label fx:id="empty_label" managed="false" styleClass="hint-text"
           text="Cette personne ne partage aucune vidéo." visible="false"/>
</VBox>
