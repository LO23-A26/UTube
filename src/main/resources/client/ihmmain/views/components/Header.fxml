<?xml version="1.0" encoding="UTF-8"?>

<!-- Header commun des écrans connectés (barre blanche de 68 px, charte 8.1) -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.SVGPath?>

<HBox alignment="CENTER_LEFT" minHeight="68.0" prefHeight="68.0" spacing="24.0" styleClass="header"
      stylesheets="@../../css/utube.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets left="28.0" right="28.0"/>
    </padding>

    <fx:include source="Logo.fxml"/>

    <!-- Recherche : filtre l'Accueil par titre, créateur ou tags -->
    <StackPane alignment="CENTER_LEFT" prefWidth="380.0" minWidth="200.0">
        <TextField fx:id="search_field" promptText="Rechercher (titre, créateur, tags)"
                   styleClass="search-field"/>
        <SVGPath content="M11 11 L15 15 M12 6.5 A5.5 5.5 0 1 1 1 6.5 A5.5 5.5 0 1 1 12 6.5 Z"
                 mouseTransparent="true" styleClass="icon-secondary">
            <StackPane.margin>
                <Insets left="14.0"/>
            </StackPane.margin>
        </SVGPath>
    </StackPane>

    <!-- Menu : l'onglet actif reçoit la classe nav-tab-active -->
    <HBox alignment="CENTER_LEFT" spacing="4.0">
        <Button fx:id="home_tab" styleClass="nav-tab" text="Accueil"/>
        <Button fx:id="downloads_tab" styleClass="nav-tab" text="Téléchargements"/>
        <Button fx:id="shares_tab" styleClass="nav-tab" text="Partages"/>
        <Button fx:id="friends_tab" styleClass="nav-tab" text="Amis"/>
    </HBox>

    <Region HBox.hgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT" spacing="16.0">
        <!-- Affiche ou masque le panneau utilisateur·rice·s -->
        <Button fx:id="toggle_users_panel_button" styleClass="bordered-icon-button">
            <graphic>
                <SVGPath content="M6 7 A3 3 0 1 0 6 1 A3 3 0 1 0 6 7 Z M0.5 15 C0.5 11.5 3 9.5 6 9.5 C9 9.5 11.5 11.5 11.5 15 M12 7.5 A2.5 2.5 0 1 0 11.5 2.5 M14 10 C15.5 10.5 16.5 12.5 16.5 15"
                         styleClass="icon"/>
            </graphic>
        </Button>
        <!-- Avatar : ouvre Mon profil (12) -->
        <Button fx:id="my_profile_button" styleClass="avatar-button" text="Me"/>
        <Button fx:id="logout_button" text="Se déconnecter"/>
    </HBox>
</HBox>
