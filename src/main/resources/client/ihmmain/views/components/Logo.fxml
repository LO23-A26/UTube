<?xml version="1.0" encoding="UTF-8"?>

<!-- Logo UTube : U jaune entourant un triangle de lecture noir, suivi du nom (charte 8.1) -->

<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.SVGPath?>

<HBox alignment="CENTER_LEFT" spacing="6.0" stylesheets="@../../css/utube.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <Group>
        <SVGPath content="M2 0 V12 A8 8 0 0 0 18 12 V0" styleClass="logo-u"/>
        <SVGPath content="M7 6.5 L14 11 L7 15.5 Z" styleClass="logo-play"/>
    </Group>
    <Label styleClass="logo-text" text="UTube"/>
</HBox>
