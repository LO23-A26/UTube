<?xml version="1.0" encoding="UTF-8"?>

<!-- Contact d'une liste (écran 10). Bouton « Retirer », ou « Débloquer » pour la liste Bloqués. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Circle?>

<HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="list-row" stylesheets="@../../css/utube.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="10.0" top="10.0"/>
    </padding>
    <Circle fx:id="avatar_circle" radius="17.0" styleClass="avatar"/>
    <!-- Un clic sur le pseudo ouvre le Détail utilisateur·rice (11) -->
    <Hyperlink fx:id="pseudo_link" text="Pseudo"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="remove_button" text="Retirer"/>
</HBox>
