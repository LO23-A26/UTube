<?xml version="1.0" encoding="UTF-8"?>

<!-- 01 Connexion : carte centrée, hors connexion (sans header ni panneau) -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="800.0" prefWidth="1280.0" styleClass="offline-background"
           stylesheets="@../css/utube.css"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <VBox maxHeight="-Infinity" maxWidth="420.0" spacing="16.0" styleClass="card">
        <padding>
            <Insets bottom="36.0" left="36.0" right="36.0" top="36.0"/>
        </padding>

        <fx:include source="components/Logo.fxml"/>
        <Label styleClass="page-title" text="Connexion"/>

        <VBox spacing="8.0">
            <Label styleClass="field-label" text="Pseudo"/>
            <TextField fx:id="pseudo_field"/>
        </VBox>
        <VBox spacing="8.0">
            <Label styleClass="field-label" text="Mot de passe"/>
            <PasswordField fx:id="password_field"/>
        </VBox>
        <HBox spacing="12.0">
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Adresse IP du serveur"/>
                <TextField fx:id="server_ip_field"/>
            </VBox>
            <VBox prefWidth="110.0" spacing="8.0">
                <Label styleClass="field-label" text="Port"/>
                <TextField fx:id="server_port_field"/>
            </VBox>
        </HBox>

        <!-- Échec d'authentification ou de connexion au serveur (séquence 5.1.2.1) -->
        <Label fx:id="error_label" managed="false" styleClass="error-label" visible="false" wrapText="true"/>

        <Button fx:id="connect_button" defaultButton="true" maxWidth="Infinity" styleClass="primary-button"
                text="Se connecter"/>

        <HBox alignment="CENTER_LEFT">
            <Hyperlink fx:id="create_profile_link" text="Créer un profil"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Ouvre un sélecteur de fichier système -->
            <Hyperlink fx:id="import_profile_link" text="Importer un profil"/>
        </HBox>
    </VBox>
</StackPane>
