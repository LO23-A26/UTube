<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Maquette v2 · 10b Ajouter un contact (fenêtre) -->
<VBox styleClass="modal" prefWidth="508" maxHeight="-Infinity" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.ihmmain.AddContactDialogController"
      style="-fx-spacing: 8px;">
    <Label fx:id="dialog_title_label" styleClass="modal-title"/>
    <Label text="Utilisateur·rice·s connu·e·s qui ne sont pas encore dans la liste." styleClass="text-secondary"/>

    <ScrollPane fitToWidth="true" maxHeight="300" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="available_users_container"/>
    </ScrollPane>
    <Label fx:id="empty_label" text="Tout le monde est déjà dans cette liste." styleClass="text-secondary"
           visible="false" managed="${empty_label.visible}"/>

    <HBox styleClass="actions" style="-fx-padding: 8px 0 0 0;">
        <Button text="Fermer" cancelButton="true" onAction="#close"/>
        <Button text="Terminer" styleClass="primary" defaultButton="true" onAction="#close"/>
    </HBox>
</VBox>
