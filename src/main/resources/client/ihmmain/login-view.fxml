<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Maquette v2 · 01 Connexion -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.ihmmain.LoginController">
    <VBox styleClass="card,large" spacing="18" maxWidth="420" maxHeight="-Infinity"
          style="-fx-padding: 36px;">
        <ImageView fitHeight="28" preserveRatio="true">
            <Image url="@../../assets/logo/utube.png"/>
        </ImageView>

        <Label text="Connexion" styleClass="page-title"/>

        <VBox spacing="6">
            <Label text="Pseudo" styleClass="field-label" labelFor="$pseudoField"/>
            <TextField fx:id="pseudoField"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Mot de passe" styleClass="field-label" labelFor="$passwordField"/>
            <PasswordField fx:id="passwordField"/>
        </VBox>

        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Adresse IP du serveur" styleClass="field-label" labelFor="$ipField"/>
                <TextField fx:id="ipField"/>
            </VBox>
            <VBox spacing="6" prefWidth="110" minWidth="110">
                <Label text="Port" styleClass="field-label" labelFor="$portField"/>
                <TextField fx:id="portField"/>
            </VBox>
        </HBox>

        <Label fx:id="errorLabel" styleClass="text-secondary" wrapText="true"
               visible="false" managed="${errorLabel.visible}"/>

        <Button text="Se connecter" styleClass="primary" defaultButton="true"
                maxWidth="Infinity" onAction="#connect"/>

        <HBox>
            <!-- Écrans 02 · Créer un profil / Importer un profil : pas encore implémentés -->
            <Hyperlink text="Créer un profil"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Importer un profil"/>
        </HBox>
    </VBox>
</StackPane>
