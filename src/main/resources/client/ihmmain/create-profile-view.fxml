<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.DatePicker?>

<!-- Profile creation view -->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.ihmmain.CreateProfileController">

    <VBox styleClass="card,large"
          spacing="18"
          maxWidth="620"
          maxHeight="-Infinity"
          style="-fx-padding: 36px;">

        <!-- Logo UTube -->
        <ImageView fitHeight="28" preserveRatio="true">
            <Image url="@../../assets/logo/utube.png"/>
        </ImageView>

        <!-- Title -->
        <Label text="Créer un profil" styleClass="page-title"/>

        <!-- Avatar -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <Circle fx:id="avatar_preview"
                    radius="36"
                    fill="#E6E7E3"
                    stroke="#D9DBE0"
                    strokeWidth="1"/>

            <Button text="Choisir un avatar"
                    onAction="#chooseAvatar"/>
        </HBox>

        <!-- Form in 2 columns -->
        <GridPane hgap="16" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <!-- Pseudo -->
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Pseudo"
                       styleClass="field-label"
                       labelFor="$pseudoField"/>
                <TextField fx:id="pseudoField"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Mot de passe"
                       styleClass="field-label"
                       labelFor="$passwordField"/>
                <PasswordField fx:id="passwordField"/>
            </VBox>

            <!-- Name -->
            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Nom"
                       styleClass="field-label"
                       labelFor="$last_name_field"/>
                <Label text="(optionnel)" styleClass="text-secondary"/>
                <TextField fx:id="last_name_field"/>
            </VBox>

            <!-- First name -->
            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Prénom"
                       styleClass="field-label"
                       labelFor="$first_name_field"/>
                <Label text="(optionnel)" styleClass="text-secondary"/>
                <TextField fx:id="first_name_field"/>
            </VBox>

            <!-- Date of birth -->
            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label text="Date de naissance"
                       styleClass="field-label"
                       labelFor="$birth_date_picker"/>
                <Label text="(optionnel)" styleClass="text-secondary"/>
                <DatePicker fx:id="birth_date_picker"/>
            </VBox>
        </GridPane>

        <!-- Error message -->
        <Label fx:id="error_label"
               styleClass="text-secondary"
               wrapText="true"
               visible="false"
               managed="${error_label.visible}"/>

        <!-- Actions -->
        <HBox alignment="CENTER_RIGHT" spacing="12">
            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Annuler"
                    onAction="#cancel"/>

            <Button text="Créer le profil"
                    styleClass="primary"
                    defaultButton="true"
                    onAction="#createProfile"/>
        </HBox>

    </VBox>
</StackPane>