<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Mockup v2 · layout of the logged-in screens (style guide 8.1, "Mise en page"):
    header at the top, users panel on the right, and content_pane in the center,
    where the IHMMainManager displays the current screen (04, 10, 11, 12, IHM-Share screens).
-->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.ihmmain.MainController">
    <fx:define>
        <ToggleGroup fx:id="navGroup"/>
    </fx:define>

    <!-- Maquette v2 · Header UTube -->
    <top>
        <HBox styleClass="header">
            <ImageView fitHeight="28" preserveRatio="true">
                <Image url="@../../assets/logo/utube.png"/>
            </ImageView>

            <HBox styleClass="search-field" HBox.hgrow="ALWAYS">
                <ImageView>
                    <Image url="@../../assets/icons/recherche.png"/>
                </ImageView>
                <TextField promptText="Rechercher (titre, créateur, tags)" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox styleClass="nav">
                <ToggleButton text="Accueil" styleClass="nav-link" toggleGroup="$navGroup" selected="true"/>
                <ToggleButton text="Téléchargements" styleClass="nav-link" toggleGroup="$navGroup"/>
                <ToggleButton text="Partages" styleClass="nav-link" toggleGroup="$navGroup"/>
                <ToggleButton text="Amis" styleClass="nav-link" toggleGroup="$navGroup"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button styleClass="icon-button" onAction="#toggleUsersPanel">
                    <graphic>
                        <ImageView>
                            <Image url="@../../assets/icons/utilisateurs.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Label text="Me" styleClass="avatar" minWidth="38" minHeight="38" prefWidth="38" prefHeight="38"/>
                <Button text="Se déconnecter" styleClass="small" onAction="#logout"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="content_pane"/>
    </center>

    <!-- Connected users panel -->
    <right>
        <VBox fx:id="users_panel" styleClass="users-panel" managed="${users_panel.visible}">
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 12px 0;">
                <Label text="Utilisateur·rice·s" styleClass="panel-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button styleClass="icon-button,flat" onAction="#toggleUsersPanel">
                    <graphic>
                        <ImageView>
                            <Image url="@../../assets/icons/fermer.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="users_container" spacing="4"/>
            </ScrollPane>
            <!-- Screen 03 · Serveurs (servers): not implemented yet -->
            <Hyperlink text="Gérer les serveurs"/>
        </VBox>
    </right>
</BorderPane>
